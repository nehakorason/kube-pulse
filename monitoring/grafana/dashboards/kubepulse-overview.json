{
  "title": "KubePulse Overview",
  "uid": "kubepulse-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(kubepulse_http_requests_total[1m]))",
          "legendFormat": "requests/sec"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error Rate (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "100 * sum(rate(kubepulse_http_errors_total[5m])) / sum(rate(kubepulse_http_requests_total[5m]))",
          "legendFormat": "error %"
        }
      ]
    },
    {
      "id": 3,
      "title": "Application Health (1=healthy)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [
        { "expr": "kubepulse_app_healthy", "legendFormat": "healthy" },
        { "expr": "kubepulse_app_ready", "legendFormat": "ready" }
      ]
    },
    {
      "id": 4,
      "title": "Latency P50",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(kubepulse_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        }
      ]
    },
    {
      "id": 5,
      "title": "Latency P95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(kubepulse_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 6,
      "title": "Latency P99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(kubepulse_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 7,
      "title": "CPU Utilisation (KubePulse pods)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"kubepulse\", container=\"kubepulse\"}[5m])) by (pod)",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Memory Utilisation (KubePulse pods)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=\"kubepulse\", container=\"kubepulse\"}) by (pod)",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Pod Count",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "targets": [
        {
          "expr": "kube_deployment_status_replicas_available{namespace=\"kubepulse\", deployment=\"kubepulse\"}",
          "legendFormat": "available"
        },
        {
          "expr": "kube_deployment_spec_replicas{namespace=\"kubepulse\", deployment=\"kubepulse\"}",
          "legendFormat": "desired"
        }
      ]
    },
    {
      "id": 10,
      "title": "Pod Restarts",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "increase(kube_pod_container_status_restarts_total{namespace=\"kubepulse\"}[15m])",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 11,
      "title": "HPA Desired vs Current Replicas",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "expr": "kube_horizontalpodautoscaler_status_desired_replicas{namespace=\"kubepulse\"}",
          "legendFormat": "desired"
        },
        {
          "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"kubepulse\"}",
          "legendFormat": "current"
        }
      ]
    }
  ]
}

# Copy to .env for local (non-container) runs if you want to override
# defaults. All variables have sensible defaults baked into app/config.py,
# so KubePulse runs with zero configuration out of the box.

APP_NAME=kubepulse
APP_VERSION=1.0.0
LOG_LEVEL=INFO
PORT=8000

# /api/v1/slow artificial latency bounds (seconds)
SLOW_MIN_SECONDS=0.5
SLOW_MAX_SECONDS=2.0

# /api/v1/error default failure probability (0.0 - 1.0)
ERROR_RATE=0.0

# /api/v1/work default CPU-bound iteration count
WORK_DEFAULT_ITERATIONS=2000000

# Simulated startup delay honoured by /ready (seconds) — useful for
# exercising the startup probe.
STARTUP_DELAY_SECONDS=0

# Failure-injection toggles: flip to "true" to simulate a broken pod.
FORCE_UNREADY=false
FORCE_UNHEALTHY=false
